# Local agent planning and state: each developer's own, never shared.
# .specs/ is the bigpowers-era planning tree (tag bigpowers-era holds the
# tracked copy). The engine keeps its own state in <git dir>/weftwork/.
.specs/
.weftwork/

# Machine-local agent tooling, not project source.
# scripts/ is a symlink into this machine's global bigpowers install.
/scripts
# pi per-project install (GSD copy, local agents/settings).
.pi/
.bigpowers/
# Agent worktrees.
.worktrees/

# Secrets.
.env
.env.*

node_modules/
coverage/
dist/
*.log
.DS_Store
