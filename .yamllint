---
# Default rules, except for specs/state.yaml. The bigpowers timing helper
# (scripts/bp-timing.sh) rewrites that one file with PyYAML on every
# skill call. PyYAML does not indent lists, drops the leading ---, and can
# exceed 80 columns, so the three rules it breaks skip that file only.
# See BUG-001.
extends: default

# Gate outputs are gitignored and regenerated; do not lint them.
# Listed here, not via ignore-from-file, which crashes when yamllint
# runs from a subdirectory. All paths in this file match from the
# repository root, so run yamllint there, as Preflight does. Keep in
# step with .gitignore (BUG-002).
ignore: |
  specs/blind-spots.json
  specs/traceability-matrix.json
  specs/codebase-wiki/
  specs/verifications/ADVERSARIAL_LATEST.yaml

rules:
  document-start:
    ignore: |
      specs/state.yaml
  indentation:
    ignore: |
      specs/state.yaml
  line-length:
    ignore: |
      specs/state.yaml
