---
# Default rules. document-start is an error, not the default warning, so a
# tool that drops the leading --- fails Preflight and CI (BUG-004).
extends: default

# src/fixtures/ holds test inputs kept in the style other tools write
# (PyYAML reflows lines and drops the leading ---), so they stay as found.
ignore: |
  node_modules/
  .specs/
  .weftwork/
  src/fixtures/

rules:
  document-start:
    level: error
